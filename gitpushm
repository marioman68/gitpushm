#!/usr/bin/env bash

# ==============================================================================
# Project Hub / Git Push Manager (gitpushm)
# Styled with a sleek purple/magenta TUI, mouse support, and universal DE file open
# ==============================================================================

VERSION="1.2.2"
PROJECTS_DIR="$HOME/Projects"

# Color Palette Definitions
C_RESET="\e[0m"
C_BOLD="\e[1m"
C_BORDER="\e[38;5;99m"
C_HEADER="\e[38;5;213m"
C_CYAN="\e[38;5;51m"
C_BLUE="\e[38;5;39m"
C_PURPLE="\e[38;5;141m"
C_GREEN="\e[38;5;82m"
C_YELLOW="\e[38;5;220m"
C_ORANGE="\e[38;5;208m"
C_RED="\e[38;5;196m"
C_MUTED="\e[38;5;244m"
BG_HOVER="\e[48;5;236m"

RESIZE_TRIGGERED=0

enable_mouse() {
    printf "\e[?1003h\e[?1006h\e[?25l\e[?7l"
}

disable_mouse() {
    printf "\e[?1003l\e[?1006l\e[?25h\e[?7h"
    sleep 0.05
    local garbage
    while read -t 0.05 -rsn1 garbage; do : ; done
}

on_resize() {
    RESIZE_TRIGGERED=1
}

trap 'on_resize' WINCH
trap 'disable_mouse; clear; echo ""; exit' EXIT INT TERM

repeat_char() {
    local char="$1"
    local count="$2"
    local str=""
    for ((i=0; i<count; i++)); do
        str="${str}${char}"
    done
    echo -n "$str"
}

calc_geometry() {
    TERM_COLS=$(tput cols)
    TERM_LINES=$(tput lines)

    [ "$TERM_COLS" -lt 95 ] && TERM_COLS=95
    [ "$TERM_LINES" -lt 24 ] && TERM_LINES=24

    TOTAL_W=$(( TERM_COLS - 2 ))
    LEFT_START=1
    LEFT_END=$(( TOTAL_W / 2 ))
    RIGHT_START=$(( LEFT_END + 2 ))
    RIGHT_END=$TOTAL_W

    LEFT_INNER_W=$(( LEFT_END - LEFT_START - 1 ))
    RIGHT_INNER_W=$(( RIGHT_END - RIGHT_START - 1 ))

    CONTENT_H=$(( TERM_LINES - 9 ))
    [ "$CONTENT_H" -lt 10 ] && CONTENT_H=10

    ROW_TOP=1
    ROW_TWIN_TOP=4
    ROW_TWIN_START=5
    ROW_TWIN_END=$(( ROW_TWIN_START + CONTENT_H - 1 ))
    ROW_TWIN_BOTTOM=$(( ROW_TWIN_END + 1 ))

    ROW_LEGEND_SEP=$(( ROW_TWIN_BOTTOM - 3 ))
    ROW_LEGEND_TEXT_1=$(( ROW_TWIN_BOTTOM - 2 ))
    ROW_LEGEND_TEXT_2=$(( ROW_TWIN_BOTTOM - 1 ))

    ROW_PROMPT_TOP=$(( ROW_TWIN_BOTTOM + 1 ))
    ROW_PROMPT_INPUT=$(( ROW_PROMPT_TOP + 1 ))
    ROW_PROMPT_BOTTOM=$(( ROW_PROMPT_INPUT + 1 ))
}

draw_box() {
    local rs="$1"
    local re="$2"
    local cs="$3"
    local ce="$4"
    local width=$(( ce - cs - 1 ))
    local hline
    hline=$(repeat_char "─" "$width")

    printf "\e[%d;%dH${C_BORDER}╭%s╮${C_RESET}" "$rs" "$cs" "$hline"
    for ((r=rs+1; r<re; r++)); do
        printf "\e[%d;%dH${C_BORDER}│\e[%d;%dH│${C_RESET}" "$r" "$cs" "$r" "$ce"
    done
    printf "\e[%d;%dH${C_BORDER}╰%s╯${C_RESET}" "$re" "$cs" "$hline"
}

draw_separator() {
    local row="$1"
    local cs="$2"
    local ce="$3"
    local width=$(( ce - cs - 1 ))
    local hline
    hline=$(repeat_char "─" "$width")
    printf "\e[%d;%dH${C_BORDER}├%s┤${C_RESET}" "$row" "$cs" "$hline"
}

draw_wireframe() {
    clear
    calc_geometry

    draw_box "$ROW_TOP" "$((ROW_TOP + 2))" 1 "$TOTAL_W"
    draw_box "$ROW_TWIN_TOP" "$ROW_TWIN_BOTTOM" "$LEFT_START" "$LEFT_END"
    draw_box "$ROW_TWIN_TOP" "$ROW_TWIN_BOTTOM" "$RIGHT_START" "$RIGHT_END"
    draw_box "$ROW_PROMPT_TOP" "$ROW_PROMPT_BOTTOM" 1 "$TOTAL_W"

    draw_separator "$ROW_LEGEND_SEP" "$LEFT_START" "$LEFT_END"
}

draw_left_legend() {
    printf "\e[%d;%dH   ${C_GREEN}●${C_RESET} Uncommitted   ${C_MUTED}○${C_RESET} Clean   ${C_RED}○${C_RESET} Not a Git Repo" "$ROW_LEGEND_TEXT_1" "$(( LEFT_START + 1 ))"
    printf "\e[%d;%dH   Press [q] to exit console" "$ROW_LEGEND_TEXT_2" "$(( LEFT_START + 1 ))"
}

temp_message() {
    prompt_in_dialog "$1"
    ( sleep 1.5 ) &
    local pid=$!
    local garbage
    while kill -0 $pid 2>/dev/null; do
        read -t 0.1 -rsn1 garbage
    done
}

prompt_in_dialog() {
    local prompt_str="$1"
    local prompt_len=${#prompt_str}
    local input_col=$(( 3 + prompt_len ))

    printf "\e[%d;2H%*s" "$ROW_PROMPT_INPUT" "$(( TOTAL_W - 2 ))" ""
    printf "\e[%d;%dH${C_BORDER}│${C_RESET}" "$ROW_PROMPT_INPUT" "$TOTAL_W"
    printf "\e[%d;3H%s\e[%d;%dH" "$ROW_PROMPT_INPUT" "$prompt_str" "$ROW_PROMPT_INPUT" "$input_col"
}

render_left_pane() {
    local row="$1"
    local is_hover="$2"
    local idx=$(( row - ROW_TWIN_START ))

    local bg=""
    if [ "$is_hover" -eq 1 ] && [ "$idx" -ge 0 ] && [ "$idx" -lt "$project_count" ]; then
        bg="${BG_HOVER}"
    fi

    printf "\e[%d;%dH" "$row" "$(( LEFT_START + 1 ))"
    if [ "$idx" -ge 0 ] && [ "$idx" -lt "$project_count" ]; then
        local num=$(( idx + 1 ))
        local pname="${project_names[$idx]}"
        local pstatus="${project_statuses[$idx]}"

        local avail=$(( LEFT_INNER_W - 14 ))
        [ "$avail" -lt 10 ] && avail=10

        [ ${#pname} -gt "$avail" ] && pname="${pname:0:$((avail - 1))}…"

        local fill_w=$(( LEFT_INNER_W - 14 - ${#pname} ))
        [ "$fill_w" -lt 0 ] && fill_w=0

        printf "${bg}   %b ${C_GREEN}[%2d]${C_RESET}${bg}   ${C_BOLD}%s${C_RESET}${bg}%*s${C_RESET}" \
            "$pstatus" "$num" "$pname" "$fill_w" ""
    else
        printf "${bg}%*s${C_RESET}" "$LEFT_INNER_W" ""
    fi
    printf "\e[%d;%dH${C_BORDER}│${C_RESET}" "$row" "$LEFT_END"
}

render_right_pane() {
    local row="$1"
    local is_hover="$2"
    local act_idx=$(( row - ROW_TWIN_START ))

    local bg=""
    [ "$is_hover" -eq 1 ] && [ "$act_idx" -ge 0 ] && [ "$act_idx" -le 4 ] && bg="${BG_HOVER}"

    local col_start=$(( RIGHT_START + 1 ))
    printf "\e[%d;%dH" "$row" "$col_start"

    if [ "$act_idx" -ge 0 ] && [ "$act_idx" -le 4 ]; then
        local p1=""
        local p2=""
        local raw_text=""

        case "$act_idx" in
            0) p1="${C_GREEN}[p]${C_RESET}${bg}"; p2="   Push project to GitHub"; raw_text="  [p]   Push project to GitHub" ;;
            1) p1="${C_CYAN}[o]${C_RESET}${bg}"; p2="   Open folder in File Manager"; raw_text="  [o]   Open folder in File Manager" ;;
            2) p1="${C_BLUE}[r]${C_RESET}${bg}"; p2="   Refresh project list"; raw_text="  [r]   Refresh project list" ;;
            3) p1="${C_YELLOW}[s]${C_RESET}${bg}"; p2="   Git Status check"; raw_text="  [s]   Git Status check" ;;
            4) p1="${C_RED}[q]${C_RESET}${bg}"; p2="   Exit Console"; raw_text="  [q]   Exit Console" ;;
        esac

        local text_len=${#raw_text}
        local pad=$(( RIGHT_INNER_W - text_len ))
        [ "$pad" -lt 0 ] && pad=0

        printf "${bg}  %b%b${bg}%*s${C_RESET}" "$p1" "$p2" "$pad" ""
    else
        printf "${bg}%*s${C_RESET}" "$RIGHT_INNER_W" ""
    fi
    printf "\e[%d;%dH${C_BORDER}│${C_RESET}" "$row" "$RIGHT_END"
}

open_project_folder() {
    local idx="$1"
    local ppath="${project_paths[$idx]}"
    local pname="${project_names[$idx]}"

    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$ppath" &>/dev/null &
        temp_message "[  OK  ] Opened '${pname}' in file manager."
    else
        temp_message "[ FAIL ] xdg-open utility not found."
    fi
}

push_project_flow() {
    local idx="$1"
    local ppath="${project_paths[$idx]}"
    local pname="${project_names[$idx]}"

    disable_mouse
    clear
    echo -e "${C_HEADER}${C_BOLD}◆ MANAGING PROJECT: ${pname}${C_RESET}\n"

    cd "$ppath" || return

    if [ ! -d ".git" ]; then
        echo -e "${C_YELLOW}[ WARNING ] This folder is not a Git repository yet.${C_RESET}"
        echo -ne "${C_BOLD}[ INPUT ] Would you like to initialize Git here? (y/N): ${C_RESET}"
        read -r init_choice
        if [[ "$init_choice" =~ ^[Yy]$ ]]; then
            git init
            echo -e "${C_GREEN}[  OK  ] Git repository initialized successfully!${C_RESET}\n"

            echo -ne "${C_YELLOW}[ INPUT ] Would you like to add a remote origin URL now? (y/N): ${C_RESET}"
            read -r remote_choice
            if [[ "$remote_choice" =~ ^[Yy]$ ]]; then
                echo -ne "${C_YELLOW}[ INPUT ] Enter remote URL: ${C_RESET}"
                read -r remote_url
                if [ -n "$remote_url" ]; then
                    git remote add origin "$remote_url"
                    echo -e "${C_GREEN}[  OK  ] Remote origin added!${C_RESET}\n"
                fi
            fi
        else
            echo -e "${C_YELLOW}[ INFO ] Initialization skipped.${C_RESET}"
            echo -ne "\n${C_MUTED}Press Enter to return to the hub...${C_RESET}"
            read -r
            return
        fi
    fi

    echo -e "${C_CYAN}[ INFO ] Checking repository status...${C_RESET}"
    git status -s
    echo ""

    if [ -z "$(git status --porcelain 2>/dev/null)" ]; then
        echo -e "${C_YELLOW}[ INFO ] Working tree is clean. No local changes to commit.${C_RESET}"
        echo -ne "${C_BOLD}[ INPUT ] Do you still want to force a 'git push' anyway? (y/N): ${C_RESET}"
        read -r force_push
        if [[ ! "$force_push" =~ ^[Yy]$ ]]; then
            echo -ne "\n${C_MUTED}Press Enter to return to the hub...${C_RESET}"
            read -r
            return
        fi
    else
        echo -ne "${C_YELLOW}[INPUT] Enter commit message: ${C_RESET}"
        read -r commit_msg
        [ -z "$commit_msg" ] && commit_msg="Update project files via gitpushm"

        echo -e "\n${C_CYAN}[ INFO ] Staging changes...${C_RESET}"
        git add .

        echo -e "${C_CYAN}[ INFO ] Committing changes...${C_RESET}"
        git commit -m "$commit_msg"
    fi

    echo -e "${C_CYAN}[ INFO ] Pushing to remote origin...${C_RESET}"
    if git push -u origin HEAD; then
        echo -e "\n${C_GREEN}${C_BOLD}[  OK  ] Push workflow completed for ${pname}!${C_RESET}"
    else
        echo -e "\n${C_RED}${C_BOLD}[ FAIL ] Push failed. Check your remote configuration.${C_RESET}"
    fi

    echo -ne "${C_MUTED}Press Enter to return to the hub...${C_RESET}"
    read -r
}

while true; do
    enable_mouse
    RESIZE_TRIGGERED=0

    project_names=()
    project_paths=()
    project_statuses=()

    if [ -d "$PROJECTS_DIR" ]; then
        while IFS= read -r dir; do
            pname=$(basename "$dir")
            project_names+=("$pname")
            project_paths+=("$dir")

            if [ -d "$dir/.git" ]; then
                if [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
                    project_statuses+=("${C_GREEN}●${C_RESET}")
                else
                    project_statuses+=("${C_MUTED}○${C_RESET}")
                fi
            else
                project_statuses+=("${C_RED}○${C_RESET}")
            fi
        done < <(find "$PROJECTS_DIR" -mindepth 1 -maxdepth 1 -type d | sort)
    fi

    project_count=${#project_names[@]}

    draw_wireframe

    printf "\e[2;3H${C_HEADER}${C_BOLD}◆ GIT PROJECT PUSH MANAGER${C_RESET}"
    printf "\e[2;%dH${C_MUTED}Path: ~/Projects${C_RESET}" "$(( TOTAL_W - 19 ))"
    printf "\e[2;%dH${C_BORDER}│${C_RESET}" "$TOTAL_W"

    printf "\e[%d;4H${C_CYAN}${C_BOLD} DETECTED DIRECTORIES (${project_count}) ${C_RESET}" "$ROW_TWIN_TOP"
    printf "\e[%d;%dH${C_HEADER}${C_BOLD} ACTION CENTER ${C_RESET}" "$ROW_TWIN_TOP" "$(( RIGHT_START + 3 ))"

    printf "\e[%d;4H${C_YELLOW}${C_BOLD} STATUS & QUICK LAUNCH ${C_RESET}" "$ROW_PROMPT_TOP"
    printf "\e[%d;3HType project number, [p]ush, [o]pen, [s]tatus, or [q] to exit: \e[%d;%dH${C_BORDER}│${C_RESET}" \
        "$ROW_PROMPT_INPUT" "$ROW_PROMPT_INPUT" "$TOTAL_W"

    for ((r=ROW_TWIN_START; r<=ROW_TWIN_END; r++)); do
        if [ "$r" -lt "$ROW_LEGEND_SEP" ]; then
            render_left_pane "$r" 0
        fi
        render_right_pane "$r" 0
    done

    draw_left_legend

    active_hover_side=""
    active_hover_row=0
    choice=""

    printf "\e[%d;65H" "$ROW_PROMPT_INPUT"

    while true; do
        if [ "$RESIZE_TRIGGERED" -eq 1 ]; then
            choice="r"
            break
        fi

        char=""
        if IFS= read -rsn1 -t 1 char; then
            if [[ "$char" == $'\e' ]]; then
                read -rsn2 -t 0.05 seq
                if [[ "$seq" == "[<" ]]; then
                    mouse_event=""
                    while IFS= read -rsn1 mchar; do
                        mouse_event+="$mchar"
                        [[ "$mchar" == "M" || "$mchar" == "m" ]] && break
                    done

                    if [[ "$mouse_event" =~ ^([0-9]+)\;([0-9]+)\;([0-9]+)([Mm])$ ]]; then
                        btn="${BASH_REMATCH[1]}"
                        cx="${BASH_REMATCH[2]}"
                        cy="${BASH_REMATCH[3]}"
                        action="${BASH_REMATCH[4]}"

                        side=""
                        if [ "$cy" -ge "$ROW_TWIN_START" ] && [ "$cy" -le "$ROW_TWIN_END" ]; then
                            if [ "$cx" -ge 2 ] && [ "$cx" -le "$LEFT_END" ]; then
                                if [ "$cy" -lt "$ROW_LEGEND_SEP" ]; then
                                    side="L"
                                fi
                            elif [ "$cx" -ge "$RIGHT_START" ] && [ "$cx" -le "$RIGHT_END" ]; then
                                side="R"
                            fi
                        fi

                        if [ -n "$side" ]; then
                            redraw=0
                            if [ "$side" != "$active_hover_side" ] || [ "$cy" -ne "$active_hover_row" ]; then
                                redraw=1
                            fi

                            if [ "$redraw" -eq 1 ]; then
                                [ "$active_hover_side" == "L" ] && [ "$active_hover_row" -ge "$ROW_TWIN_START" ] && render_left_pane "$active_hover_row" 0
                                [ "$active_hover_side" == "R" ] && [ "$active_hover_row" -ge "$ROW_TWIN_START" ] && render_right_pane "$active_hover_row" 0

                                [ "$side" == "L" ] && render_left_pane "$cy" 1
                                [ "$side" == "R" ] && render_right_pane "$cy" 1

                                active_hover_side="$side"
                                active_hover_row="$cy"
                                printf "\e[%d;65H" "$ROW_PROMPT_INPUT"
                            fi
                        else
                            if [ -n "$active_hover_side" ]; then
                                [ "$active_hover_side" == "L" ] && [ "$active_hover_row" -ge "$ROW_TWIN_START" ] && render_left_pane "$active_hover_row" 0
                                [ "$active_hover_side" == "R" ] && [ "$active_hover_row" -ge "$ROW_TWIN_START" ] && render_right_pane "$active_hover_row" 0
                                active_hover_side=""
                                active_hover_row=0
                                printf "\e[%d;65H" "$ROW_PROMPT_INPUT"
                            fi
                        fi

                        if [ "$btn" -eq 0 ] && [ "$action" == "M" ]; then
                            if [ "$side" == "L" ]; then
                                clicked_idx=$(( cy - ROW_TWIN_START ))
                                if [ "$clicked_idx" -lt "$project_count" ]; then
                                    choice="$(( clicked_idx + 1 ))"
                                    break
                                fi
                            elif [ "$side" == "R" ]; then
                                case $(( cy - ROW_TWIN_START )) in
                                    0) choice="p"; break ;;
                                    1) choice="o"; break ;;
                                    2) choice="r"; break ;;
                                    3) choice="s"; break ;;
                                    4) choice="q"; break ;;
                                esac
                            fi
                        fi
                    fi
                fi
            elif [[ "$char" =~ ^[0-9a-zA-Z]$ ]]; then
                choice="$char"
                break
            fi
        fi
    done

    disable_mouse

    case "$choice" in
        [Qq])
            clear
            exit 0
            ;;
        [Rr])
            continue
            ;;
        [Pp])
            prompt_in_dialog "Enter project number to push: "
            read -r proj_num
            if [[ "$proj_num" =~ ^[0-9]+$ ]] && [ "$proj_num" -ge 1 ] && [ "$proj_num" -le "$project_count" ]; then
                push_project_flow $(( proj_num - 1 ))
            else
                temp_message "[ FAIL ] Invalid selection."
            fi
            ;;
        [Oo])
            prompt_in_dialog "Enter project number to open: "
            read -r proj_num
            if [[ "$proj_num" =~ ^[0-9]+$ ]] && [ "$proj_num" -ge 1 ]] && [ "$proj_num" -le "$project_count" ]; then
                open_project_folder $(( proj_num - 1 ))
            else
                temp_message "[ FAIL ] Invalid selection."
            fi
            ;;
        [Ss])
            disable_mouse
            clear
            echo -e "${C_HEADER}${C_BOLD}◆ REPOSITORY STATUS OVERVIEW${C_RESET}\n"
            for i in "${!project_names[@]}"; do
                if [ -d "${project_paths[$i]}/.git" ]; then
                    echo -e "${C_GREEN}[*] ${project_names[$i]}${C_RESET}"
                    git -C "${project_paths[$i]}" status -s
                else
                    echo -e "${C_RED}[!] ${project_names[$i]} (Not a Git repository)${C_RESET}"
                fi
                echo ""
            done
            echo -e "${C_MUTED}Press Enter to return to hub...${C_RESET}"
            read -r
            ;;
        *)
            if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ]] && [ "$choice" -le "$project_count" ]; then
                push_project_flow $(( choice - 1 ))
            fi
            ;;
    esac
done
